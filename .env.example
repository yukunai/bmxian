# Server-side provider keys.
# Browser-entered keys are stored in the local server database and encrypted with BMXIAN_SECRET_KEY.
# Browser localStorage only keeps masked key values for fast local recovery.
# Production should move keys into an account-scoped key vault.

DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
ZAI_API_KEY=
ARK_API_KEY=
VOLCENGINE_API_KEY=
OPENAI_API_KEY=
MINIMAX_API_KEY=
ANTHROPIC_API_KEY=
CLAUDE_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
JIMENG_API_KEY=
VOLCENGINE_VISUAL_API_KEY=
KLING_API_KEY=
MIDJOURNEY_API_KEY=
BFL_API_KEY=
FLUX_API_KEY=
STABILITY_API_KEY=
STABLE_DIFFUSION_API_KEY=
BMXIAN_CUSTOM_API_KEY=

# Default OpenAI-compatible endpoints used by the app:
# DeepSeek: https://api.deepseek.com
# Qwen / DashScope China Beijing: https://dashscope.aliyuncs.com/compatible-mode/v1
# Zhipu GLM: https://open.bigmodel.cn/api/paas/v4/
# Volcengine Ark: https://ark.cn-beijing.volces.com/api/v3
# ChatGPT / OpenAI Responses API: https://api.openai.com/v1
# MiniMax OpenAI-compatible: https://api.minimax.io/v1
# Claude Messages API: https://api.anthropic.com/v1
# Gemini generateContent API: https://generativelanguage.googleapis.com/v1beta
# Jimeng visual adapter: configure the Engine Center media Provider endpoint or a self-hosted adapter, then set JIMENG_API_KEY / VOLCENGINE_VISUAL_API_KEY
# Kling video adapter: configure the Engine Center media Provider endpoint or a self-hosted adapter, then set KLING_API_KEY
# Midjourney adapter: Midjourney does not expose a stable official public API here; configure a self-hosted/third-party gateway endpoint, then set MIDJOURNEY_API_KEY
# FLUX / Black Forest Labs adapter: configure the Engine Center media Provider endpoint, then set BFL_API_KEY / FLUX_API_KEY
# GPT Image adapter: uses OPENAI_API_KEY and the GPT Image media Provider endpoint
# Stable Diffusion + LoRA adapter: configure a Stability or SD gateway endpoint, then set STABILITY_API_KEY / STABLE_DIFFUSION_API_KEY

# Future integration reservations. Leave empty until these systems are ready.
SCENELET_BASE_URL=
SCENELET_API_KEY=
LOAMTRACE_BASE_URL=
LOAMTRACE_API_KEY=

# Local development database and secret encryption.
# Change BMXIAN_SECRET_KEY before storing real keys.
BMXIAN_SECRET_KEY=
BMXIAN_MONTHLY_BUDGET_CENTS=10000

# Database adapter:
# - json: local single-machine file storage under data/bmxian-db.json
# - postgres / supabase / neon: stores the workspace JSON snapshot in Postgres
BMXIAN_DB_ADAPTER=json
DATABASE_URL=
POSTGRES_URL=
SUPABASE_DATABASE_URL=
NEON_DATABASE_URL=
BMXIAN_POSTGRES_TABLE=bmxian_workspace_store
BMXIAN_POSTGRES_STORE_KEY=workspace-state
BMXIAN_POSTGRES_POOL_SIZE=3
BMXIAN_POSTGRES_CONNECT_TIMEOUT=10
BMXIAN_POSTGRES_IDLE_TIMEOUT=20

# Auth adapter:
# - local: MVP browser cookies for local development
# - trusted-headers: identity comes from a reverse proxy / SSO gateway
BMXIAN_AUTH_ADAPTER=local
BMXIAN_AUTH_PROXY_SECRET=
BMXIAN_AUTH_TRUST_HEADER_ROLE=false

BMXIAN_PAYMENT_PROVIDER=manual
BMXIAN_CHECKOUT_BASE_URL=
BMXIAN_WEBHOOK_SECRET=
JIMENG_WEBHOOK_SECRET=
VOLCENGINE_WEBHOOK_SECRET=
KLING_WEBHOOK_SECRET=
BMXIAN_STORE_REMOTE_MEDIA=false
BMXIAN_MAX_MEDIA_RESULT_BYTES=52428800
BMXIAN_MEDIA_STORAGE_ADAPTER=local
BMXIAN_MEDIA_BUCKET=
BMXIAN_MEDIA_PUBLIC_BASE_URL=
BMXIAN_MEDIA_ENDPOINT=
BMXIAN_MEDIA_REGION=
BMXIAN_MEDIA_ACCESS_KEY_ID=
BMXIAN_MEDIA_SECRET_ACCESS_KEY=
